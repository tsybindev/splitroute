{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SplitRoute",
  "version": "0.1.3",
  "identifier": "com.splitroute.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SplitRoute",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tsybindev/splitroute/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGNkI0QTQ4QzJFOUNFRTcKUldUbnp1bkNTRXByNzFNZ0NCWmVMZ1F4ZXpFaDBOajNHc1dFeXFqNmJqN2VvNDkvK3RIVW5oREEK",
      "requireSignedVersion": true
    }
  }
}
