      {
        "tag": "fragment-out",
        "protocol": "freedom",
        "settings": {
          "fragment": {
            "packets": "tlshello",
            "length": "100-200",
            "interval": "10-20"
          }
        },
        "streamSettings": {
          "sockopt": {
            "tcpFastOpen": true,
            "tcpKeepAliveIdle": 60,
            "tcpNoDelay": true
          }
        }
      }
