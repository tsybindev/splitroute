{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SplitRoute",
  "version": "0.1.0",
  "identifier": "com.splitroute.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SplitRoute",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "category": "Utility"
  }
}
